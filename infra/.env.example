# Environment Toggle
NODE_ENV=development
APP_ENV=development

# -------------------------------------------------------------------
# INVSYS: Template Example Environment (.env.example)
# CLONE THIS FILE TO .env AND POPULATE PASSWORDS LOCALLY
# -------------------------------------------------------------------

# ----------------------------------------
# Shared Infrastructure (Docker Compose)
# ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_postgres_password_here

# ----------------------------------------
# Auth Service (NestJS)
# ----------------------------------------
AUTH_APP_PORT=3001
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=your_local_postgres_password_here
AUTH_DB_NAME=auth_db
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# ----------------------------------------
# Products Service (NestJS)
# ----------------------------------------
PRODUCTS_APP_PORT=3002
PRODUCTS_DB_HOST=localhost
PRODUCTS_DB_PORT=5432
PRODUCTS_DB_USER=postgres
PRODUCTS_DB_PASSWORD=your_local_postgres_password_here
PRODUCTS_DB_NAME=products_db

# External Exchange Rate API
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6/
EXCHANGE_RATE_API_KEY=your_api_key_here
CURRENCY_CACHE_TTL_SECONDS=3600

# ----------------------------------------
# Inventory Service (Golang)
# ----------------------------------------
INVENTORY_APP_PORT=8080
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5432
INVENTORY_DB_USER=postgres
INVENTORY_DB_PASSWORD=your_local_postgres_password_here
INVENTORY_DB_NAME=inventory_db

# ----------------------------------------
# Shared Message Broker (Kafka)
# ----------------------------------------
KAFKA_BROKER_URL=localhost:9092
KAFKA_BROKER_USER=admin
KAFKA_BROKER_PASSWORD=your_kafka_password_here

# ----------------------------------------
# Shared Cache (Redis)
# ----------------------------------------
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=your_redis_password_here
